# Frontend (set in Vercel frontend project)
# Local development uses the /api proxy; leave this unset locally.
# VITE_API_URL=https://your-backend.vercel.app/api

# Backend (set in Vercel backend project)
SECRET_KEY=your-strong-random-secret-key
DEBUG=False
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
ALLOWED_HOSTS=your-backend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Server-only optional integrations
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FRONTEND_URL=http://127.0.0.1:5175/

# Email OTP recovery (server-only SMTP credentials)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Optional authorized profile-data provider. POST {"url": "https://www.linkedin.com/in/..."}
# must return {"profile_text": "..."}. Direct LinkedIn scraping is not implemented.
LINKEDIN_PROFILE_API_URL=
LINKEDIN_PROFILE_API_KEY=
